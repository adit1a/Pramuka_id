{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
 "routes": [
    {
        "src": "/(css|js|images|img|assets|uploads|bootstrap)/(.*)",
        "dest": "/public/$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
      
    }
    
  ]
}