{
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.0"
        }
    },
    "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "LOG_CHANNEL": "stderr",
    "APP_STORAGE": "/tmp/storage",
    "BOOTSTRAP_CACHE_PATH": "/tmp/storage/bootstrap/cache",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views"
},
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}